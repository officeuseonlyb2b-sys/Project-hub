{
  "rules": {
    ".read": false,
    ".write": false,
    "executionHub": {
      "workspaces": {
        "default": {
          "state": {
            ".read": "auth != null && root.child('executionHub/admin/authorization').child(auth.uid).child('uid').val() === auth.uid && root.child('executionHub/admin/authorization').child(auth.uid).child('role').val() === 'system_admin' && root.child('executionHub/admin/authorization').child(auth.uid).child('status').val() === 'active'",
            ".write": "auth != null && root.child('executionHub/admin/authorization').child(auth.uid).child('uid').val() === auth.uid && root.child('executionHub/admin/authorization').child(auth.uid).child('role').val() === 'system_admin' && root.child('executionHub/admin/authorization').child(auth.uid).child('status').val() === 'active'"
          }
        }
      },
      "users": {
        "$uid": {
          ".read": "auth != null && ((root.child('executionHub/admin/authorization').child(auth.uid).child('uid').val() === auth.uid && root.child('executionHub/admin/authorization').child(auth.uid).child('role').val() === 'system_admin' && root.child('executionHub/admin/authorization').child(auth.uid).child('status').val() === 'active') || auth.uid === $uid)",
          ".write": "auth != null && ((root.child('executionHub/admin/authorization').child(auth.uid).child('uid').val() === auth.uid && root.child('executionHub/admin/authorization').child(auth.uid).child('role').val() === 'system_admin' && root.child('executionHub/admin/authorization').child(auth.uid).child('status').val() === 'active') || (auth.uid === $uid && newData.child('uid').val() === $uid && newData.child('role').val() === 'employee' && newData.child('status').val() === 'active'))",
          ".validate": "!newData.exists() || (newData.child('uid').val() === $uid && newData.child('role').val() === 'employee' && newData.child('status').val() !== 'admin' && newData.child('status').val() !== 'director' && newData.child('email').val() !== 'ashish@arpitatravels.com')"
        }
      },
      "admin": {
        "authorization": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid && data.child('uid').val() === auth.uid && data.child('role').val() === 'system_admin' && data.child('status').val() === 'active'",
            ".write": false
          }
        },
        "private": {
          ".read": "auth != null && root.child('executionHub/admin/authorization').child(auth.uid).child('uid').val() === auth.uid && root.child('executionHub/admin/authorization').child(auth.uid).child('role').val() === 'system_admin' && root.child('executionHub/admin/authorization').child(auth.uid).child('status').val() === 'active'",
          ".write": "auth != null && root.child('executionHub/admin/authorization').child(auth.uid).child('uid').val() === auth.uid && root.child('executionHub/admin/authorization').child(auth.uid).child('role').val() === 'system_admin' && root.child('executionHub/admin/authorization').child(auth.uid).child('status').val() === 'active'"
        }
      }
    }
  }
}
